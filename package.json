{
  "name": "@flowscripter/io-gateway-http",
  "version": "1.0.2",
  "description": "Local HTTP gateway serving pluggable-io-framework IOProvider locations to tools that only speak HTTP",
  "keywords": [
    "bun",
    "gateway",
    "http",
    "io",
    "library",
    "pluggable-io-framework"
  ],
  "homepage": "https://github.com/flowscripter/io-gateway-http#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/io-gateway-http.git"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@flowscripter/pluggable-io-framework": "^2.1.1",
    "@flowscripter/pluggable-io-framework-api": "^3.1.3"
  },
  "devDependencies": {
    "@flowscripter/io-plugin-filesystem": "^2.0.3",
    "@flowscripter/io-plugin-http": "^1.0.1",
    "@flowscripter/io-plugin-s3": "^1.0.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
